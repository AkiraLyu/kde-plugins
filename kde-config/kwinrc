# Better Blur DX 负责模糊，关闭 KDE 自带 Blur，避免两个效果同时工作。
# Rounded Corners 显式启用，不再依赖包的默认开关。
[Plugins]
better_blur_dxEnabled=true
blurEnabled=false
kwin4_effect_shapecornersEnabled=true
wechat-glass-live-v5Enabled=true

# 微信两条栏的透明由插件负责；XWayland 窗口写入模糊区域，Wayland 窗口改用
# Better Blur DX 的强制模糊。
[Effect-wechat-glass-live]
BackgroundOpacity=0.52
Enabled=true

# 模糊强度、饱和度和窗口匹配。wechat 同时覆盖 Wayland 原生窗口和 XWayland 窗口：
# 强制模糊对已经自带模糊区域的窗口不生效，因此不会与插件的模糊区域冲突。
# CornerRadius 与 Shape Corners 的 16 一致，避免圆角外露出方形模糊。
[Effect-better-blur-dx]
BlurStrength=2
CornerRadius=16
Saturation=250
WindowClasses=/^(md[.]obsidian[.]Obsidian|chatgpt|wechat)$/

# 圆角半径 16；最大化和平铺时也保留圆角。
[Round-Corners]
ActiveOutlineAlpha=0
ActiveSecondOutlineAlpha=2
AnimationDuration=0
DisableRoundMaximize=false
DisableRoundTile=false
InactiveCornerRadius=16
InactiveOutlineAlpha=0
InactiveOutlineColor=255,255,255
InactiveOutlineThickness=0
InactiveSecondOutlineAlpha=0
InactiveSecondOutlineThickness=0
InactiveShadowSize=25
Inclusions=code
OutlineColor=255,255,255
OutlineThickness=0
SecondOutlineThickness=0
ShadowSize=50
Size=16
Squircleness=0
